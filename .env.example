# CARC Configuration
# Copy this file to .env and adjust paths for your system

# Path to the directory containing raw proxy record CSV files
CARC_DATA_DIR=proxy_records

# Path to the directory containing age error CSV files (optional)
CARC_ERROR_DIR=proxy_errors

# Path for output files (tier tables, edge lists, CSVs)
CARC_OUTPUT_DIR=outputs

# Path for generated figures
CARC_FIGURE_DIR=figures


